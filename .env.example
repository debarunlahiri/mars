# ---- LLM provider (auto = first of anthropic/openai/google with a key, else offline mock) ----
MARS_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Provider values: anthropic | openai | google_genai | mock
# Defaults per provider (override below):
#   anthropic     claude-haiku-5-5 / claude-sonnet-5-5
#   openai        gpt-4o-mini / gpt-4o
#   google_genai  gemini-3.5-flash-lite / gemini-3.8-flash   (older Gemini names return 404 for new accounts)
# MARS_FAST_MODEL=claude-haiku-5-5      # planner + researchers
# MARS_STRONG_MODEL=claude-sonnet-5-5   # analyst + writer + critic
# MARS_LLM_TIMEOUT=90

# ---- Search & page reading (auto = Tavily if key set, else DuckDuckGo; DDG is always the fallback) ----
MARS_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
MARS_FETCH_PAGES=true        # read full pages, not just snippets (needed for quote verification to be strong)
MARS_FETCH_TOP_K=3
MARS_RESPECT_ROBOTS=true
MARS_BLOCKED_DOMAINS=pinterest.com,facebook.com,instagram.com,tiktok.com,x.com

# ---- Budgets ----
MARS_MAX_TASKS=4
MARS_MAX_RESULTS=5
MARS_MAX_ROUNDS=2
MARS_MAX_REVISIONS=2
MARS_RUN_TIMEOUT=300

# ---- API ----
MARS_API_KEYS=               # comma-separated; EMPTY = NO AUTH (local dev only)
MARS_RATE_LIMIT_PER_MIN=20
MARS_MAX_CONCURRENT_RUNS=4
MARS_CORS_ORIGINS=
MARS_CHECKPOINT_DB=          # SQLite file so paused approvals survive restarts (ignored if DATABASE_URL set)

# ---- Storage & memory ----
# Postgres (+pgvector): reports, vector index AND run checkpoints. Needs the `vector` extension.
MARS_DATABASE_URL=           # postgresql://user:pass@host:5432/mars
# ...or a single SQLite file for reports + vectors (local use, exact search)
MARS_STORAGE_DB=             # e.g. ./mars-data.db
# Embeddings: auto = OpenAI if OPENAI_API_KEY, else local fastembed if installed, else offline hash (lexical only)
MARS_EMBEDDING_PROVIDER=auto
# MARS_EMBEDDING_MODEL=text-embedding-3-small
MARS_USE_MEMORY=false        # let new research reuse verified quotes from earlier reports
MARS_MEMORY_TOP_K=3
MARS_MEMORY_MIN_SCORE=0.4

# ---- Internal documents (PDF, Word, PowerPoint, Excel, images, text) ----
# Setting this enables uploads (POST /documents, `mars ingest <path>`) and makes research cite them.
MARS_DOCS_DB=                # e.g. ./mars-docs.db
MARS_DOCS_DIR=               # e.g. ./knowledge : watched folder, new/changed/deleted files sync automatically
MARS_DOCS_SYNC_INTERVAL=30   # seconds between scans (0 = only at startup / on POST /documents/sync)
MARS_USE_DOCUMENTS=true
MARS_WEB_SEARCH=true         # false = answer from your documents only
MARS_DOCS_TOP_K=4
MARS_MAX_UPLOAD_MB=25
MARS_VISION_IMAGES=true      # read images/scans with the LLM (needs a real provider; OCR extra is the offline fallback)
# Local models (embeddings) run on: auto = NVIDIA GPU (cuda) > Apple GPU (mps) > cpu
MARS_DEVICE=auto
# GPU embeddings: pip install 'mars[gpu]' and set MARS_EMBEDDING_PROVIDER=local

# ---- Logging / observability ----
MARS_LOG_LEVEL=INFO
MARS_LOG_JSON=false
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=mars
